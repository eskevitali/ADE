# LLM API Keys
OPENROUTER_API_KEY=
XAI_API_KEY=

# Optional: other providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=info

# Auth
SESSION_SECRET=ade-v4-change-this-secret-in-production
ADMIN_USERNAME=eskevitali@gmail.com
ADMIN_PASSWORD=777025!Jestex

# Docker / Services
QDRANT_URL=http://localhost:6333
POSTGRES_URL=postgresql://ade:ade@localhost:5433/ade
REDIS_URL=redis://localhost:6379/0

# Domain / Nginx
DOMAIN=ade.kider.at

# LLM
LLM_CACHE_ENABLED=true
DEFAULT_TEMPERATURE=0.2

# ─────────────────────────────────────────────
# Git — для init/commit/push (НЕ коммитить .env)
# ─────────────────────────────────────────────
# URL репозитория (HTTPS или SSH)
# Примеры:
#   https://github.com/USERNAME/ADE-V4.git
#   git@github.com:USERNAME/ADE-V4.git
GIT_REMOTE_URL=

# Ветка по умолчанию
GIT_DEFAULT_BRANCH=main

# Автор коммитов
GIT_USER_NAME=
GIT_USER_EMAIL=

# HTTPS push: Personal Access Token (GitHub/GitLab)
# GitHub: Settings → Developer settings → Personal access tokens
#   scopes: repo (private) или public_repo
# GitLab: Settings → Access Tokens → api/write_repository
GIT_USERNAME=
GIT_TOKEN=

# Опционально: SSH (если GIT_REMOTE_URL = git@...)
# Путь к приватному ключу на сервере, например /root/.ssh/id_ed25519
GIT_SSH_KEY_PATH=
