// =============================================
// READING POSITION MANAGER (Domain Layer)
// =============================================

package com.readvoice.domain.manager

import com.readvoice.domain.model.ReadingSession
import com.readvoice.domain.repository.ReadingSessionRepository // assume interface exists

class ReadingPositionManager(
    private val sessionRepository: ReadingSessionRepository
) {
    suspend fun savePosition(documentId: String, position: Int, page: Int, mode: com.readvoice.domain.model.ReadingMode) {
        val session = ReadingSession(
            documentId = documentId,
            currentPosition = position,
            currentPage = page,
            readingMode = mode,
            lastUpdated = System.currentTimeMillis()
        )
        sessionRepository.insertOrUpdate(session)
    }
}
